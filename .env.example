# =============================================================================
# Squad Academy — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# DESENVOLVIMENTO (SQLite em arquivo, dentro de `prisma/data/`).
# O caminho é relativo à raiz do projeto e resolvido para absoluto pelo
# `prisma.config.ts`, então CLI e runtime apontam para o mesmo arquivo.
DATABASE_URL="file:./prisma/data/dev.db"

# PRODUÇÃO (Turso / libSQL). Basta trocar a URL e preencher o token:
# DATABASE_URL="libsql://squad-academy-seu-user.turso.io"
# DATABASE_AUTH_TOKEN="token-gerado-pelo-turso-cli"
DATABASE_AUTH_TOKEN=""

# --- Armazenamento de arquivos (PDFs e capas) --------------------------------
# local        -> salva em public/uploads/ (dev / Docker)
# vercel-blob  -> usa o Vercel Blob (produção)
STORAGE_PROVIDER="local"

# Necessário apenas quando STORAGE_PROVIDER="vercel-blob".
# Crie o Blob store no dashboard da Vercel e cole o token aqui.
BLOB_READ_WRITE_TOKEN=""

# --- Autenticação do /admin --------------------------------------------------
ADMIN_EMAIL="admin@squadacademy.com.br"

# Em desenvolvimento, a senha em texto puro é suficiente.
ADMIN_PASSWORD="squad123"

# Em produção, prefira o hash bcrypt (gerado com `npx bcrypt-cli` ou script
# próprio). Quando preenchido, ele tem prioridade sobre ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=""

# Segredo para assinar o cookie de sessão (jose). Gere um valor aleatório,
# por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# --- Aplicação ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
