# =============================================================================
# Squad Academy — produção self-hosted (Ubuntu + Docker)
# Copie para `.env.production` e ajuste. NUNCA versione o arquivo final.
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# SQLite em arquivo dentro do volume `sqlite_data` (montado em /app/prisma/data).
DATABASE_URL="file:./prisma/data/dev.db"
DATABASE_AUTH_TOKEN=""

# Para usar Turso neste servidor, troque a URL e preencha o token:
# DATABASE_URL="libsql://squad-academy-seu-user.turso.io"

# --- Uploads ------------------------------------------------------------------
# local -> volume `uploads` em /app/public/uploads (recomendado no self-hosted)
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""

# --- Admin --------------------------------------------------------------------
ADMIN_EMAIL="admin@seudominio.local"

# Opção A (simples): senha em texto puro.
ADMIN_PASSWORD="troque-esta-senha"

# Opção B (recomendada): hash bcrypt. Se preenchido, tem prioridade.
# Gere com:
#   docker compose -f docker-compose.prod.yml --profile tools run --rm migrate \
#     node -e "require('bcryptjs').hash('SUA_SENHA', 10).then(console.log)"
ADMIN_PASSWORD_HASH=""

# --- Sessão -------------------------------------------------------------------
# Gere um valor aleatório:
#   openssl rand -hex 32
SESSION_SECRET=""

# Cookie `Secure`: vazio = automático (proxy/HTTPS -> true; HTTP na LAN -> false).
# Só preencha se quiser forçar: "true" ou "false".
COOKIE_SECURE=""

# --- Aplicação ----------------------------------------------------------------
# IMPORTANTE: é embutido no build. Use o endereço real de acesso
# (ex.: http://192.168.0.10:3000 ou https://squad.seudominio.com).
NEXT_PUBLIC_SITE_URL="http://192.168.0.10:3000"
